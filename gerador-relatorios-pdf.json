    {
      "parameters": {
        "jsCode": "// Set default values with debug\nconst input = $input.first().json;\n\nconsole.log('INPUT:', JSON.stringify(input, null, 2));\n\n// Parse dates - if already ISO with timezone, keep as-is\n// isEnd=true sets time to end of day so the full last day is included\nconst parseToISO = (dateStr, isEnd = false) => {\n  if (!dateStr) return null;\n  if (typeof dateStr === 'string' && dateStr.includes('T') && dateStr.endsWith('Z')) {\n    return dateStr;\n  }\n  // Date only (YYYY-MM-DD) — use start or end of day accordingly\n  if (typeof dateStr === 'string' && !dateStr.includes('T')) {\n    return dateStr + (isEnd ? 'T23:59:59.999Z' : 'T00:00:00.000Z');\n  }\n  return dateStr;\n};\n\nconst start_date = parseToISO(input.start_date, false) || new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\nconst end_date = parseToISO(input.end_date, true) || new Date().toISOString();\nconst type = input.type || 'company';\nconst device_id = (type === 'device' && input.device_id) ? input.device_id : null;\n\nconsole.log('Parsed start_date:', start_date);\nconsole.log('Parsed end_date:', end_date);\nconsole.log('type:', type, '| device_id:', device_id);\n\nreturn [{\n  json: {\n    type: type,\n    device_id: device_id,\n    start_date: start_date,\n    end_date: end_date,\n    company_name: input.company_name || 'Geral',\n    device_name: input.device_name || input.device_id || 'Todos',\n    device_code: input.device_code || input.device_id || '--',\n    ala: input.ala || '--'\n  }\n}];"
      },
