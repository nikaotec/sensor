        "jsCode": "const binaryData = await $input.first().binary.data.toBuffer();\nconst base64String = binaryData.toString('base64');\n\nreturn [{\n  json: {\n    pdf_base64: base64String,\n    fileName: 'relatorio_telemetria.pdf',\n    mimeType: 'application/pdf'\n  }\n}];"
