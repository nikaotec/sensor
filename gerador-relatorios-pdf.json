    {
      "parameters": {
        "jsCode": "// Format WhatsApp message\nconst stats = $('Processar Dados').first().json.stats;\nconst config = $('Set Defaults').first().json;\n\nconst message = `📊 *RELATÓRIO DE TELEMETRIA*\\n\\n` +\n`📍 *Dispositivo(s):* ${stats.device_name}\\n` +\n`📅 *Período:* ${stats.period}\\n` +\n`📈 *Total de registros:* ${stats.total_records}\\n\\n` +\n`*TEMPERATURA:*\\n` +\n`  Média: ${stats.temp_avg}°C\\n` +\n`  Máxima: ${stats.temp_max}°C\\n` +\n`  Mínima: ${stats.temp_min}°C\\n\\n` +\n`*OUTROS DADOS:*\\n` +\n`  Umidade Média: ${stats.humidity_avg}%\\n` +\n`  Bateria Média: ${stats.battery_avg}V\\n` +\n`  Tensão Média: ${stats.voltage_avg}V\\n\\n` +\n`⏰ Relatório gerado: ${new Date().toLocaleString('pt-BR')}`;\n\n// Return message even if no recipients (for testing)\nreturn [{ json: { message, phone: '5581999999999' } }];"
      },
