    {
      "parameters": {
        "jsCode": "// Set default values\nconst input = $input.first().json;\n\n// Ensure full ISO timestamps for Supabase\nconst formatEndDate = (d) => {\n  if (!d) return new Date().toISOString().split('T')[0] + 'T23:59:59Z';\n  return d.includes('T') ? d : d + 'T23:59:59Z';\n};\n\nconst formatStartDate = (d) => {\n  if (!d) return new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] + 'T00:00:00Z';\n  return d.includes('T') ? d : d + 'T00:00:00Z';\n};\n\nreturn [{\n  json: {\n    type: input.type || 'company',\n    device_id: input.device_id || null,\n    start_date: formatStartDate(input.start_date),\n    end_date: formatEndDate(input.end_date),\n    company_name: input.company_name || 'Geral',\n    device_name: input.device_name || input.device_id || 'Todos',\n    device_code: input.device_code || input.device_id || '--',\n    ala: input.ala || '--'\n  }\n}];"
      },
      "id": "5d1fce98-4236-4312-80bc-dd0cc344994f",
      "name": "Set Defaults",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        14640,
        4016
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "telemetry",
        "filters": {
          "conditions": [
            {
              "keyName": "device_id",
              "condition": "eq",
              "keyValue": "={{ $json.device_id }}"
            },
            {
              "keyName": "timestamp",
              "condition": "gte",
              "keyValue": "={{ $json.start_date }}"
            },
            {
              "keyName": "timestamp",
              "condition": "lte",
              "keyValue": "={{ $json.end_date }}"
            }
          ]
        }
      },
      "id": "e5855b8b-f9c8-4e7c-bad2-b4013b33e01f",
      "name": "Buscar Telemetry",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        14832,
        4016
      ],
      "credentials": {
        "supabaseApi": {
          "id": "mwfq69YpUvhBFjds",
          "name": "supabase_sensor"
        }
