    {
      "parameters": {
        "jsCode": "// Process and prepare all data for HTML Report\nlet html_rows = '';\nlet stats = {\n  total_records: 0, temp_avg: '--', temp_max: '--', temp_min: '--',\n  humidity_avg: '--', battery_avg: '--', voltage_avg: '--',\n  device_name: 'Todos', device_code: '--', company_name: 'Geral', ala: 'Não informada',\n  period: 'Período não informado', year: new Date().getFullYear(), month: ''\n};\n\ntry {\n  const telemetryData = $('Buscar Telemetry').all();\n  const config = $('Set Defaults').first().json;\n\n  const formatDate = (isoStr) => {\n    if (!isoStr) return '';\n    const d = new Date(isoStr);\n    return d.toLocaleDateString('pt-BR');\n  };\n\n  stats.device_name = config.device_name || 'Todos';\n  stats.device_code = config.device_code || '--';\n  stats.company_name = config.company_name || 'Geral';\n  stats.ala = config.ala || 'Não informada';\n  stats.period = `${formatDate(config.start_date)} a ${formatDate(config.end_date)}`;\n  const reportDate = config.start_date ? new Date(config.start_date) : new Date();\n  stats.year = reportDate.getFullYear();\n  stats.month = reportDate.toLocaleString('pt-BR', { month: 'long' });\n\n  let data = [];\n  if (telemetryData && telemetryData.length > 0) {\n    data = telemetryData.map(t => t.json).sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));\n    \n    const avg = arr => arr.length ? (arr.reduce((a,b) => a + b, 0) / arr.length).toFixed(1) : '0';\n    \n    const temps = data.map(d => d.temperature).filter(v => v != null);\n    const humidities = data.map(d => d.humidity).filter(v => v != null);\n    const batteries = data.map(d => d.battery).filter(v => v != null);\n    const voltages = data.map(d => d.voltage).filter(v => v != null);\n\n    stats.total_records = data.length;\n    stats.temp_avg = avg(temps);\n    stats.temp_max = temps.length ? Math.max(...temps).toFixed(1) : '0';\n    stats.temp_min = temps.length ? Math.min(...temps).toFixed(1) : '0';\n    stats.humidity_avg = avg(humidities);\n    stats.battery_avg = avg(batteries);\n    stats.voltage_avg = avg(voltages);\n  }\n\n  // Generate HTML Rows\n  const diasAgrupados = {};\n  data.forEach(linha => {\n    const dt = new Date(linha.timestamp);\n    const dia = dt.getDate();\n    if (!dia) return;\n    \n    if (!diasAgrupados[dia]) {\n      diasAgrupados[dia] = { dia: dia, manhas: [], tardes: [] };\n    }\n    \n    const entry = {\n      HORA: dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }),\n      TEMP: linha.temperature != null ? linha.temperature.toFixed(1) : '--',\n      MAX: linha.temp_max != null ? linha.temp_max.toFixed(1) : '--',\n      MIN: linha.temp_min != null ? linha.temp_min.toFixed(1) : '--'\n    };\n\n    if (dt.getHours() >= 12) diasAgrupados[dia].tardes.push(entry);\n    else diasAgrupados[dia].manhas.push(entry);\n  });\n\n  Object.values(diasAgrupados).sort((a, b) => a.dia - b.dia).forEach(grupo => {\n    const maxLen = Math.max(grupo.manhas.length, grupo.tardes.length, 1);\n    for (let i = 0; i < maxLen; i++) {\n      const m = grupo.manhas[i] || { HORA: '', TEMP: '', MAX: '', MIN: '' };\n      const t = grupo.tardes[i] || { HORA: '', TEMP: '', MAX: '', MIN: '' };\n      html_rows += '<tr>' +\n        '<td style=\"text-align:center;\">' + (i === 0 ? grupo.dia : '') + '</td>' +\n        '<td>' + m.HORA + '</td><td>' + m.MAX + '</td><td>' + m.MIN + '</td><td>' + m.TEMP + '</td><td></td>' +\n        '<td>' + t.HORA + '</td><td>' + t.MAX + '</td><td>' + t.MIN + '</td><td>' + t.TEMP + '</td><td></td>' +\n        '<td></td>' +\n        '</tr>';\n    }\n  });\n} catch (e) {\n  console.error(e);\n}\n\nreturn [{ json: { stats, html_rows } }];"
      },
