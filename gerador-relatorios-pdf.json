<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
    
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; }
    
    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      padding: 10px;
      color: #334155;
      background: #fff;
    }

    .company-block {
      margin-bottom: 40px;
    }

    .header {
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 10px;
      margin-bottom: 15px;
    }

    .header-info h1 {
      font-size: 18px;
      margin: 0 0 5px 0;
      color: #0f172a;
    }

    .header-info p {
      font-size: 11px;
      margin: 0;
      color: #64748b;
    }

    .report-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
      table-layout: fixed;
    }

    .report-table th {
      background: #0f172a;
      color: #f8fafc;
      padding: 6px 2px;
      text-align: center;
      border: 1px solid #1e293b;
      font-weight: 700;
      text-transform: uppercase;
    }

    .report-table td {
      padding: 5px 2px;
      text-align: center;
      border: 1px solid #e2e8f0;
      color: #1e293b;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .report-table th:first-child, .report-table td:first-child {
      width: 120px;
    }

    .report-table tr:nth-child(even) {
      background: #f8fafc;
    }

    .device-header {
      background: #334155 !important;
      color: #fff !important;
      text-align: left !important;
      padding: 8px 12px !important;
      font-size: 10px;
      font-weight: 700;
      border: none !important;
    }

    .time-cell {
      font-weight: 600;
      color: #0f172a;
    }

    @page {
      size: A4 landscape;
      margin: 1cm;
    }

    .footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      font-size: 8px;
      color: #94a3b8;
      text-align: center;
      padding: 5px 0;
      border-top: 1px solid #e2e8f0;
    }
  </style>
</head>
<body>
  {{{ $json.html_content }}}
  <div class="footer">
    Gerado automaticamente em {{ $json.stats.report_date }} | &copy; {{ $json.stats.year }} Relatório de Telemetria
  </div>
</body>
</html>