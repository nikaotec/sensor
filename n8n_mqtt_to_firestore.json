{
  "name": "IoT Sensor - MQTT to Firestore",
  "nodes": [
    {
      "parameters": {
        "topics": "esp32c3/data,esp32c3/dashboard",
        "options": {}
      },
      "id": "e3b0c442-989b-464c-8b8d-2a1d3fdef451",
      "name": "MQTT Trigger",
      "type": "n8n-nodes-base.mqttTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payloadString = $input.item.json.message;\ntry {\n  const payload = JSON.parse(payloadString);\n  return { json: payload };\n} catch(e) {\n  return { json: { error: 'Invalid JSON', payload: payloadString } };\n}"
      },
      "id": "164e2229-bfda-4b10-85f9-2c7020d1c810",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "4540c497-2a44-4822-ba35-c33583ae139c",
              "leftValue": "={{ $json.DISPOSITIVO }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1f7aab5-25df-4d6b-bd85-e3d6bfbb4f3b",
      "name": "Validate Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 3,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "projectId": "smartrf-f9962",
        "collection": "devices_status",
        "documentId": "={{ $json.ID_DISPOSITIVO }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "name",
              "fieldValue": "={{ $json.DISPOSITIVO }}"
            },
            {
              "fieldId": "temperature",
              "fieldValue": "={{ parseFloat($json.TEMP_ATUAL) }}"
            },
            {
              "fieldId": "voltage",
              "fieldValue": "={{ parseFloat($json.VOLTAGEM) }}"
            },
            {
              "fieldId": "humidity",
              "fieldValue": "={{ parseFloat($json.UMIDADE || 0) }}"
            },
            {
              "fieldId": "battery",
              "fieldValue": "={{ parseFloat($json.BATERIA || 0) }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "online"
            },
            {
              "fieldId": "lastSeen",
              "fieldValue": "={{ new Date().toISOString() }}"
            },
            {
              "fieldId": "tenantId",
              "fieldValue": "={{ $json.EMPRESA || 'Unknown' }}"
            }
          ]
        }
      },
      "id": "b960b7b1-213c-4a33-8b77-3e1b0d2d34a4",
      "name": "Upsert Firestore Device Status",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "projectId": "smartrf-f9962",
        "collection": "telemetry",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "deviceId",
              "fieldValue": "={{ $json.DISPOSITIVO.replace(/\\s+/g, '_').toLowerCase() }}"
            },
            {
              "fieldId": "temperature",
              "fieldValue": "={{ parseFloat($json.TEMP_ATUAL) }}"
            },
            {
              "fieldId": "voltage",
              "fieldValue": "={{ parseFloat($json.VOLTAGEM) }}"
            },
            {
              "fieldId": "humidity",
              "fieldValue": "={{ parseFloat($json.UMIDADE || 0) }}"
            },
            {
              "fieldId": "battery",
              "fieldValue": "={{ parseFloat($json.BATERIA || 0) }}"
            },
            {
              "fieldId": "timestamp",
              "fieldValue": "={{ new Date().toISOString() }}"
            },
            {
              "fieldId": "tenantId",
              "fieldValue": "empresa_default"
            }
          ]
        }
      },
      "id": "da5d5904-6f4e-4f01-9a74-d4d03e9ff7da",
      "name": "Insert Telemetry Log",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [
        900,
        350
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    id: $input.item.json.ID_DISPOSITIVO,\n    company: $input.item.json.EMPRESA || \"empresa_default\",\n    ala: \"Setor Principal\",\n    device_name: $input.item.json.DISPOSITIVO || $input.item.json.ID_DISPOSITIVO,\n    temp: parseFloat($input.item.json.TEMP_ATUAL),\n    tempMax: parseFloat($input.item.json.MAX || $input.item.json.TEMP_ATUAL),\n    tempMin: parseFloat($input.item.json.MIN || $input.item.json.TEMP_ATUAL),\n    batteryVoltage: parseFloat($input.item.json.BATERIA || 0),\n    inputVoltage: parseFloat($input.item.json.VOLTAGEM || 0),\n    signal: parseInt($input.item.json.RSSI || 0)\n  }\n};"
      },
      "id": "format-dash-1234",
      "name": "Format for Dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        550
      ]
    },
    {
      "parameters": {
        "operation": "publish",
        "topic": "sensor/telemetry/data",
        "message": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "mqtt-pub-dash-54321",
      "name": "Publish to Dashboard",
      "type": "n8n-nodes-base.mqtt",
      "typeVersion": 1,
      "position": [
        1120,
        550
      ]
    }
  ],
  "connections": {
    "MQTT Trigger": {
      "main": [
        [
          {
            "node": "Parse Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Payload": {
      "main": [
        [
          {
            "node": "Validate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Data": {
      "main": [
        [
          {
            "node": "Upsert Firestore Device Status",
            "type": "main",
            "index": 0
          },
          {
            "node": "Insert Telemetry Log",
            "type": "main",
            "index": 0
          },
          {
            "node": "Format for Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format for Dashboard": {
      "main": [
        [
          {
            "node": "Publish to Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}