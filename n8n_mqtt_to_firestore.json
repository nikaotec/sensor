{
  "name": "IoT Sensor - MQTT to Firestore",
  "nodes": [
    {
      "parameters": {
        "topics": "esp32c3/data,esp32c3/dashboard"
      },
      "id": "mqtt-trigger-main",
      "name": "MQTT Trigger",
      "type": "n8n-nodes-base.mqttTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payloadString = $input.item.json.message;\ntry {\n  const payload = JSON.parse(payloadString);\n  return { json: payload };\n} catch(e) {\n  return { json: { error: 'Invalid JSON', payload: payloadString } };\n}"
      },
      "id": "parse-payload-main",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.DISPOSITIVO }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.ID_DISPOSITIVO }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "validate-data-main",
      "name": "Validate Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "projectId": "smartrf-f9962",
        "collection": "devices_status",
        "documentId": "={{$json.ID_DISPOSITIVO}}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "name",
              "fieldValue": "={{$json.DISPOSITIVO}}"
            },
            {
              "fieldId": "temperature",
              "fieldValue": "={{parseFloat($json.TEMP_ATUAL)}}"
            },
            {
              "fieldId": "voltage",
              "fieldValue": "={{parseFloat($json.VOLTAGEM)}}"
            },
            {
              "fieldId": "humidity",
              "fieldValue": "={{parseFloat($json.UMIDADE || 0)}}"
            },
            {
              "fieldId": "battery",
              "fieldValue": "={{parseFloat($json.BATERIA || 0)}}"
            },
            {
              "fieldId": "status",
              "fieldValue": "online"
            },
            {
              "fieldId": "lastSeen",
              "fieldValue": "={{ $now.setZone('America/Sao_Paulo').toISO() }}"
            },
            {
              "fieldId": "tenantId",
              "fieldValue": "={{$json.EMPRESA || 'Unknown'}}"
            }
          ]
        }
      },
      "id": "upsert-status-main",
      "name": "Upsert Firestore Device Status",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "projectId": "smartrf-f9962",
        "collection": "telemetry",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "deviceId",
              "fieldValue": "={{$json.ID_DISPOSITIVO}}"
            },
            {
              "fieldId": "temperature",
              "fieldValue": "={{parseFloat($json.TEMP_ATUAL)}}"
            },
            {
              "fieldId": "voltage",
              "fieldValue": "={{parseFloat($json.VOLTAGEM)}}"
            },
            {
              "fieldId": "humidity",
              "fieldValue": "={{parseFloat($json.UMIDADE || 0)}}"
            },
            {
              "fieldId": "battery",
              "fieldValue": "={{parseFloat($json.BATERIA || 0)}}"
            },
            {
              "fieldId": "timestamp",
              "fieldValue": "={{ $now.setZone('America/Sao_Paulo').toISO() }}"
            },
            {
              "fieldId": "expireAt",
              "fieldValue": "={{ $now.setZone('America/Sao_Paulo').plus({ days: 1 }).toISO() }}"
            },
            {
              "fieldId": "tenantId",
              "fieldValue": "={{ $json.EMPRESA || 'Unknown' }}"
            }
          ]
        }
      },
      "id": "insert-telemetry-main",
      "name": "Insert Telemetry Log",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    id: $input.item.json.ID_DISPOSITIVO,\n    company: $input.item.json.EMPRESA || \"empresa_default\",\n    ala: \"Setor Principal\",\n    device_name: $input.item.json.DISPOSITIVO || $input.item.json.ID_DISPOSITIVO,\n    temp: parseFloat($input.item.json.TEMP_ATUAL || 0),\n    tempMax: parseFloat($input.item.json.MAX || $input.item.json.TEMP_ATUAL || 0),\n    tempMin: parseFloat($input.item.json.MIN || $input.item.json.TEMP_ATUAL || 0),\n    batteryVoltage: parseFloat($input.item.json.BATERIA || 0),\n    inputVoltage: parseFloat($input.item.json.VOLTAGEM || 0),\n    signal: parseInt($input.item.json.RSSI || 0)\n  }\n};"
      },
      "id": "format-dash-main",
      "name": "Format for Dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        500
      ]
    },
    {
      "parameters": {
        "operation": "publish",
        "topic": "sensor/telemetry/data",
        "message": "={{ JSON.stringify($json) }}"
      },
      "id": "mqtt-pub-main",
      "name": "Publish to Dashboard",
      "type": "n8n-nodes-base.mqtt",
      "typeVersion": 1,
      "position": [
        1120,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.TIPO }}",
              "operation": "equals",
              "value2": "DASHBOARD_PERIODIC"
            },
            {
              "value1": "={{ $json.TIPO }}",
              "operation": "equals",
              "value2": "periodico"
            },
            {
              "value1": "={{ $json.TIPO }}",
              "operation": "equals",
              "value2": "horario"
            },
            {
              "value1": "={{ $json.TIPO }}",
              "operation": "equals",
              "value2": "historico"
            }
          ]
        }
      },
      "id": "filter-telemetry-main",
      "name": "Filter Telemetry",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "MQTT Trigger": {
      "main": [
        [
          {
            "node": "Parse Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Payload": {
      "main": [
        [
          {
            "node": "Validate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Data": {
      "main": [
        [
          {
            "node": "Upsert Firestore Device Status",
            "type": "main",
            "index": 0
          },
          {
            "node": "Filter Telemetry",
            "type": "main",
            "index": 0
          },
          {
            "node": "Format for Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format for Dashboard": {
      "main": [
        [
          {
            "node": "Publish to Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Telemetry": {
      "main": [
        [
          {
            "node": "Insert Telemetry Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}