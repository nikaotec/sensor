{
    "name": "IoT Sensor - Events Logger Supabase",
    "nodes": [
        {
            "parameters": {
                "topics": "esp32c3/data"
            },
            "id": "mqtt-trigger-events",
            "name": "MQTT Trigger",
            "type": "n8n-nodes-base.mqttTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const payloadString = $input.item.json.message;\ntry {\n  const payload = JSON.parse(payloadString);\n  return { json: payload };\n} catch(e) {\n  return { json: { error: 'Invalid JSON', payload: payloadString } };\n}"
            },
            "id": "parse-payload-events",
            "name": "Parse Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.TIPO }}",
                            "operation": "startsWith",
                            "value2": "ALERTA_"
                        },
                        {
                            "value1": "={{ $json.TIPO }}",
                            "operation": "contains",
                            "value2": "NORMALIZADA"
                        }
                    ]
                },
                "combineOperation": "any"
            },
            "id": "is-alert-event",
            "name": "Is Alert Event?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.IS_REPEAT }}",
                            "operation": "notEqual",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "filter-repeats",
            "name": "Not a Repeat?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                860,
                280
            ]
        },
        {
            "parameters": {
                "operation": "create",
                "tableId": "events",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "device_id",
                            "fieldValue": "={{ $json.ID_DISPOSITIVO }}"
                        },
                        {
                            "fieldId": "type",
                            "fieldValue": "={{ $json.TIPO }}"
                        },
                        {
                            "fieldId": "msg",
                            "fieldValue": "={{ ($json.DISPOSITIVO || 'Dispositivo') + ': ' + ($json.TIPO.replace(/_/g, ' ').toLowerCase()) }}"
                        },
                        {
                            "fieldId": "severity",
                            "fieldValue": "={{ $json.TIPO.startsWith('ALERTA_') ? 'critical' : 'info' }}"
                        },
                        {
                            "fieldId": "tenant_id",
                            "fieldValue": "={{ $json.EMPRESA || 'Unknown' }}"
                        },
                        {
                            "fieldId": "timestamp",
                            "fieldValue": "={{ $now.setZone('America/Sao_Paulo').toISO() }}"
                        }
                    ]
                }
            },
            "id": "insert-supabase-events",
            "name": "Insert Event Supabase",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                1080,
                260
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "mwfq69YpUvhBFjds",
                    "name": "supabase_sensor"
                }
            }
        }
    ],
    "connections": {
        "MQTT Trigger": {
            "main": [
                [
                    {
                        "node": "Parse Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse Payload": {
            "main": [
                [
                    {
                        "node": "Is Alert Event?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Alert Event?": {
            "main": [
                [
                    {
                        "node": "Not a Repeat?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Not a Repeat?": {
            "main": [
                [
                    {
                        "node": "Insert Event Supabase",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}