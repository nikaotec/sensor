{
    "name": "IoT Sensor - Hourly Logging to Supabase",
    "nodes": [
        {
            "parameters": {
                "topics": "esp32c3/data"
            },
            "id": "mqtt-trigger-hourly",
            "name": "MQTT Trigger",
            "type": "n8n-nodes-base.mqttTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const payloadString = $input.item.json.message;\ntry {\n  const payload = JSON.parse(payloadString);\n  return { json: payload };\n} catch(e) {\n  return { json: { error: 'Invalid JSON', payload: payloadString } };\n}"
            },
            "id": "parse-payload-hourly",
            "name": "Parse Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.TIPO }}",
                            "operation": "equals",
                            "value2": "periodico"
                        }
                    ]
                }
            },
            "id": "filter-periodic-hourly",
            "name": "Filter Periodic",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "operation": "create",
                "tableId": "telemetry",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "device_id",
                            "fieldValue": "={{ $json.ID_DISPOSITIVO }}"
                        },
                        {
                            "fieldId": "temperature",
                            "fieldValue": "={{ parseFloat($json.TEMP_ATUAL) }}"
                        },
                        {
                            "fieldId": "voltage",
                            "fieldValue": "={{ parseFloat($json.VOLTAGEM) }}"
                        },
                        {
                            "fieldId": "humidity",
                            "fieldValue": "={{ parseFloat($json.UMIDADE || 0) }}"
                        },
                        {
                            "fieldId": "battery",
                            "fieldValue": "={{ parseFloat($json.BATERIA || 0) }}"
                        },
                        {
                            "fieldId": "timestamp",
                            "fieldValue": "={{ new Date().toISOString() }}"
                        }
                    ]
                }
            },
            "id": "insert-supabase-hourly",
            "name": "Insert Hourly Log",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                860,
                300
            ]
        }
    ],
    "connections": {
        "MQTT Trigger": {
            "main": [
                [
                    {
                        "node": "Parse Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse Payload": {
            "main": [
                [
                    {
                        "node": "Filter Periodic",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Periodic": {
            "main": [
                [
                    {
                        "node": "Insert Hourly Log",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}