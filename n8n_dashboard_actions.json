{
    "name": "Dashboard Actions Logger",
    "nodes": [
        {
            "parameters": {
                "topics": "esp32c3/status/action",
                "jsonParse": true
            },
            "id": "mqtt-trigger-dashboard",
            "name": "MQTT Trigger",
            "type": "n8n-nodes-base.mqttTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ],
            "credentials": {
                "mqtt": {
                    "id": "BHuPlzoyNhQIduWz",
                    "name": "MQTT account"
                }
            }
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [],
                    "string": [
                        {
                            "value1": "={{ $json.source }}",
                            "value2": "dashboard"
                        }
                    ]
                }
            },
            "id": "filter-dashboard-source",
            "name": "Filter Dashboard",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const data = $input.item.json;\nlet intencao = data.intencao || 'comando_desconhecido';\nlet source = data.source || 'dashboard';\nlet deviceId = data.id || 'desconhecido';\nlet userName = (data.user && data.user.name) ? data.user.name : 'Usuário Web';\nlet userEmail = (data.user && data.user.email) ? data.user.email : '';\n\nlet message = '';\nswitch(intencao) {\n  case 'ligar_rele': message = 'Relé ligado manualmente'; break;\n  case 'desligar_rele': message = 'Relé desligado manualmente'; break;\n  case 'modo_manutencao': message = 'Modo de Manutenção ATIVADO'; break;\n  case 'modo_operacional': message = 'Modo Operacional ATIVADO'; break;\n  case 'configurar_limites': message = `Limites atualizados: T.Max(${data.temp_max||'-'}), T.Min(${data.temp_min||'-'}), V.Max(${data.volt_max||'-'}), V.Min(${data.volt_min||'-'}), Bat.Min(${data.bat_min||'-'})`; break;\n  case 'silenciar_alarme': message = 'Alarme silenciado'; break;\n  case 'calibrar_tensao': message = `Tensão principal calibrada para ${data.nova_tensao}V`; break;\n  case 'calibrar_bateria': message = `Bateria calibrada para ${data.nova_tensao}V`; break;\n  default: message = `Comando executado: ${intencao}`;\n}\n\nif (userEmail) {\n  message += ` (via painel web por ${userName} - ${userEmail})`;\n} else {\n  message += ` (via painel web por ${userName})`;\n}\n\nreturn {\n  json: {\n    deviceId: deviceId,\n    message: message,\n    type: 'info',\n    timestamp: new Date().toISOString()\n  }\n};"
            },
            "id": "format-event-log",
            "name": "Format Event Log",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                280
            ]
        },
        {
            "parameters": {
                "operation": "create",
                "projectId": "smartrf-f9962",
                "collection": "events",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "deviceId",
                            "fieldValue": "={{$json.deviceId}}"
                        },
                        {
                            "fieldId": "message",
                            "fieldValue": "={{$json.message}}"
                        },
                        {
                            "fieldId": "type",
                            "fieldValue": "={{$json.type}}"
                        },
                        {
                            "fieldId": "timestamp",
                            "fieldValue": "={{$json.timestamp}}"
                        }
                    ]
                }
            },
            "id": "insert-event-firestore",
            "name": "Insert Event Firestore",
            "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
            "typeVersion": 1,
            "position": [
                860,
                280
            ]
        }
    ],
    "connections": {
        "MQTT Trigger": {
            "main": [
                [
                    {
                        "node": "Filter Dashboard",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Dashboard": {
            "main": [
                [
                    {
                        "node": "Format Event Log",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Event Log": {
            "main": [
                [
                    {
                        "node": "Insert Event Firestore",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}