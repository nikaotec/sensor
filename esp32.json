    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst tipo = (item.TIPO || item['0']?.TIPO || '').toString();\nconst remoteJid = item.REMOTE_JID || '';\n\n// Map of ESP32 response types to human-friendly WhatsApp messages\nconst mensagens = {\n  'MANUTENCAO_ATIVADA':     '\ud83d\udd27 *Modo Manuten\u00e7\u00e3o ativado!*\\n\\nTodos alertas e relat\u00f3rios foram suspensos.\\nO dispositivo est\u00e1 em manuten\u00e7\u00e3o.',\n  'MANUTENCAO_DESATIVADA':  '\u2705 *Modo Operacional restaurado!*\\n\\nO sistema voltou ao monitoramento autom\u00e1tico.',\n  'EM_MANUTENCAO':          '\u26a0\ufe0f *Dispositivo em manuten\u00e7\u00e3o.*\\n\\nComandos bloqueados. Envie \"operacional\" para sair do modo manuten\u00e7\u00e3o.',\n  'ALARME_SILENCIADO':      '\ud83d\udd15 *Alarme silenciado.*\\n\\nOs alertas persistentes foram suspensos at\u00e9 normaliza\u00e7\u00e3o.',\n  'ERRO_NAO_AUTORIZADO':    '\ud83d\udeab *Acesso negado.*\\n\\nVoc\u00ea n\u00e3o tem permiss\u00e3o para executar este comando.',\n  'feedback_comando':        '\u2705 *Comando executado com sucesso.*',\n  'feedback_configuracao':  '\u2699\ufe0f *Configura\u00e7\u00e3o atualizada com sucesso!*',\n  'feedback_calibracao_sucesso': '\ud83d\udccf *Calibra\u00e7\u00e3o realizada com sucesso!*',\n  'feedback_calibracao_bateria': '\ud83d\udd0b *Calibra\u00e7\u00e3o de bateria realizada!*',\n  'ALERTA_ERRO_CALIBRACAO_FATOR': '\u274c *Erro na calibra\u00e7\u00e3o:* fator inv\u00e1lido.',\n  'ALERTA_ERRO_CALIBRACAO_TENSAO_BAIXA': '\u274c *Erro na calibra\u00e7\u00e3o:* tens\u00e3o lida muito baixa.',\n};\n\nconst mensagem = mensagens[tipo];\n\n// Is this a command response? (has a known tipo AND has remoteJid)\nif (mensagem && remoteJid) {\n  return [{\n    json: {\n      _tipo_resposta: 'COMANDO',\n      remoteJid: remoteJid,\n      msg: mensagem\n    }\n  }];\n}\n\n// Otherwise: it's telemetry data - pass through to AI Agent as-is\nreturn [{\n  json: {\n    _tipo_resposta: 'TELEMETRIA',\n    ...item\n  }\n}];\n"
      },
