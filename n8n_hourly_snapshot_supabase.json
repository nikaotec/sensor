{
    "name": "IoT Sensor - Hourly Snapshot (Supabase)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 1
                        }
                    ]
                }
            },
            "id": "schedule-hourly",
            "name": "Schedule Hourly",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "operation": "getAll",
                "tableId": "devices_status",
                "returnAll": true
            },
            "id": "get-devices",
            "name": "Get Devices",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const device = $input.item.json;\n\nreturn [{\n  json: {\n    device_id: device.id,\n    temperature: device.temperature || 0,\n    humidity: device.humidity || 0,\n    voltage: device.voltage || 0,\n    battery: device.battery || 0,\n    timestamp: new Date().toISOString()\n  }\n}];"
            },
            "id": "format-telemetry",
            "name": "Format Telemetry",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "operation": "create",
                "tableId": "telemetry",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "device_id",
                            "fieldValue": "={{ $json.device_id }}"
                        },
                        {
                            "fieldId": "temperature",
                            "fieldValue": "={{ $json.temperature }}"
                        },
                        {
                            "fieldId": "humidity",
                            "fieldValue": "={{ $json.humidity }}"
                        },
                        {
                            "fieldId": "voltage",
                            "fieldValue": "={{ $json.voltage }}"
                        },
                        {
                            "fieldId": "battery",
                            "fieldValue": "={{ $json.battery }}"
                        },
                        {
                            "fieldId": "timestamp",
                            "fieldValue": "={{ $json.timestamp }}"
                        }
                    ]
                }
            },
            "id": "save-telemetry",
            "name": "Save Telemetry",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                850,
                300
            ]
        }
    ],
    "connections": {
        "Schedule Hourly": {
            "main": [
                [
                    {
                        "node": "Get Devices",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Devices": {
            "main": [
                [
                    {
                        "node": "Format Telemetry",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Telemetry": {
            "main": [
                [
                    {
                        "node": "Save Telemetry",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}