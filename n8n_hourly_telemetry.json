{
    "name": "IoT Sensor - Hourly Logging to Supabase (FIXED)",
    "nodes": [
        {
            "parameters": {
                "topics": "esp32c3/data"
            },
            "name": "MQTT Trigger",
            "type": "n8n-nodes-base.mqttTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const payloadString = $input.item.json.message;\ntry {\n  const payload = JSON.parse(payloadString);\n  return { json: payload };\n} catch(e) {\n  return { json: { error: 'Invalid JSON', payload: payloadString } };\n}"
            },
            "name": "Parse Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
"conditions": {
                    "logic": "or",
                    "conditions": [
                        {
                            "string": [
                                {
                                    "value1": "={{$json.TIPO}}",
                                    "value2": "relatorio_diario"
                                }
                            ]
                        },
                        {
                            "string": [
                                {
                                    "value1": "={{$json.TIPO}}",
                                    "value2": "periodico"
                                }
                            ]
                        }
                    ]
                },
            "name": "Filter Periodic",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "operation": "create",
                "tableId": "telemetry",
                "fieldsUi": {
                    "fieldValues": [
                        {
                            "fieldId": "device_id",
                            "fieldValue": "={{$json.ID_DISPOSITIVO}}"
                        },
                        {
                            "fieldId": "temperature",
                            "fieldValue": "={{parseFloat($json.TEMP_C)}}"
                        },
                        {
                            "fieldId": "temp_max",
                            "fieldValue": "={{parseFloat($json.TEMP_MAX)}}"
                        },
                        {
                            "fieldId": "temp_min",
                            "fieldValue": "={{parseFloat($json.TEMP_MIN)}}"
                        },
                        {
                            "fieldId": "voltage",
                            "fieldValue": "={{parseFloat($json.VOLTAGEM)}}"
                        },
                        {
                            "fieldId": "humidity",
                            "fieldValue": "={{parseFloat($json.UMIDADE || 0)}}"
                        },
                        {
                            "fieldId": "battery",
                            "fieldValue": "={{parseFloat($json.BATERIA || 0)}}"
                        },
                        {
                            "fieldId": "timestamp",
                            "fieldValue": "={{ $now.setZone('America/Sao_Paulo').toISO() }}"
                        },
                        {
                            "fieldId": "data_registro",
                            "fieldValue": "={{ $now.setZone('America/Sao_Paulo').toFormat('yyyy-MM-dd') }}"
                        },
                        {
                            "fieldId": "hora_registro",
                            "fieldValue": "={{ $now.setZone('America/Sao_Paulo').toFormat('HH:00:00') }}"
                        }
                    ]
                }
            },
            "name": "Insert Hourly Log",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                860,
                300
            ]
        }
    ],
    "connections": {
        "MQTT Trigger": {
            "main": [
                [
                    {
                        "node": "Parse Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse Payload": {
            "main": [
                [
                    {
                        "node": "Filter Periodic",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Periodic": {
            "main": [
                [
                    {
                        "node": "Insert Hourly Log",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}